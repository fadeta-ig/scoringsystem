    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.26.0",
    "mariadb": "3.5.3",
    "next": "16.2.11",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
